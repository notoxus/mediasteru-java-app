<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <id>Win</id>
    <formats><format>zip</format></formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar</source>
            <outputDirectory>/</outputDirectory>
            <destName>MediaSteru.jar</destName>
        </file>
        <file>
            <source>${project.basedir}/tools-manifest.json</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/tools</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>yt-dlp.exe</include>
                <include>ffmpeg-win-x64.exe</include>
                <include>deno-win-x64.exe</include>
                <include>run.bat</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/tools/jre-win</directory>
            <outputDirectory>/jre</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
